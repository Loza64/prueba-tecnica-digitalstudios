{
  "name": "nodets-backend-app",
  "version": "1.0.0",
  "description": "API de planillas: detalle y envío a SAP (simulado). Express + Prisma + SQL Server, arquitectura hexagonal",
  "main": "build/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "cross-env DEBUG=nodets:* ts-node-dev -r tsconfig-paths/register src/index.ts",
    "start": "node build/index.js",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "swagger": "ts-node-dev src/swagger.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "Loza64",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "opossum": "^10.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}